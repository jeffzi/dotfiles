#!/usr/bin/env bash

{{ template "bash-lib" }}

#==============================================================================
# Install Rust via rustup
#==============================================================================

# Installs what is missing only: an installed toolchain is never updated here.
# Upgrades belong to the `update` fish function.

if ! command -v rustup &> /dev/null; then
    info "Installing rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi

if ! rustup toolchain list | grep -q '^stable-'; then
    info "Installing Rust stable toolchain..."
    rustup toolchain install stable
fi
rustup default stable

info "Installing Rust components..."
rustup component add clippy rustfmt rust-analyzer

success "Rust toolchain installation complete!"
