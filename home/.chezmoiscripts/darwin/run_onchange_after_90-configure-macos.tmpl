#!/usr/bin/env bash

{{ template "bash-lib" }}

# https://github.com/mathiasbynens/dotfiles/blob/main/.macos
# https://macos-defaults.com/
#
# The settings live in .chezmoidata/macos.yaml. They are rendered into
# each_setting below, so editing the YAML changes this script and chezmoi
# re-runs it on the next apply. Settings that need root are in
# run_onchange_after_89-configure-system.

failures=0

# Calls <function> once per setting from macos.yaml, as:
#   <function> <currentHost: 0|1> <domain> <key> <type> <value...>
each_setting() {
    local fn="$1"
{{- range .macosDefaults }}
    "$fn" {{ if get . "currentHost" }}1{{ else }}0{{ end }} {{ .domain | quote }} {{ .key | quote }}
{{- " " }}{{ .type }}
{{- if eq .type "array" }}{{ range .value }} {{ . | toString | quote }}{{ end }}
{{- else }} {{ .value | toString | quote }}{{ end }}
{{- end }}
}

# A sandboxed app reads its settings from its container. macOS protects some
# containers (Safari's) so that only a terminal with Full Disk Access can
# touch them; every write there fails without it.
container_blocked() {
    local container="$HOME/Library/Containers/$1"
    [[ -d "$container" ]] && ! ls "$container/Data/Library/Preferences" &>/dev/null
}

blocked_domains=" "
collect_blocked() {
    local domain="$2"
    if [[ "$blocked_domains" != *" $domain "* ]] && container_blocked "$domain"; then
        blocked_domains+="$domain "
    fi
}

skipped() {
    [[ "$blocked_domains" == *" $2 "* ]]
}

apply_setting() {
    local host="$1" domain="$2" key="$3" type="$4"
    shift 4
    skipped "$host" "$domain" && return 0

    local defaults_cmd=(defaults)
    [[ "$host" == 1 ]] && defaults_cmd+=(-currentHost)

    if ! "${defaults_cmd[@]}" write "$domain" "$key" "-$type" "$@"; then
        warning "Failed to write $domain $key"
        failures=$((failures + 1))
    fi
}

# Reads a setting back and compares it with what apply_setting wrote.
# `defaults read` prints booleans as 1/0 and arrays as a parenthesised list,
# so both sides are normalised to that form before comparing.
verify_setting() {
    local host="$1" domain="$2" key="$3" type="$4"
    shift 4
    skipped "$host" "$domain" && return 0

    local defaults_cmd=(defaults)
    [[ "$host" == 1 ]] && defaults_cmd+=(-currentHost)

    local expected
    case "$type" in
        bool) [[ "$1" == true ]] && expected=1 || expected=0 ;;
        array) expected="($(IFS=,; printf '%s' "$*"))" ;;
        *) expected="$1" ;;
    esac

    local actual
    if ! actual=$("${defaults_cmd[@]}" read "$domain" "$key" 2>/dev/null); then
        actual="<missing>"
    elif [[ "$type" == array ]]; then
        actual=$(tr -d ' \n\t"' <<<"$actual")
    fi

    if [[ "$actual" != "$expected" ]]; then
        warning "Setting verification failed: $domain $key (expected: $expected, got: $actual)"
        failures=$((failures + 1))
    fi
}

restart_affected_apps() {
    info "Restarting affected applications..."

    # cfprefsd first, so the others reload the settings written above.
    local app
    for app in cfprefsd Dock Finder SystemUIServer; do
        if killall "$app" &>/dev/null; then
            success "Restarted $app"
        fi
    done

    info "Note: Some settings require logout/restart to take full effect"
}

# An open System Settings window can write back the values it loaded,
# overriding the settings written below.
if pgrep -xq "System Settings"; then
    osascript -e 'tell application "System Settings" to quit' || warning "Failed to quit System Settings"
fi

each_setting collect_blocked
if [[ "$blocked_domains" != " " ]]; then
    warning "Skipping settings for${blocked_domains% }: grant Full Disk Access to this terminal in System Settings > Privacy & Security, then re-run this script with: chezmoi state delete --bucket=entryState --key=\"\$HOME/.chezmoiscripts/darwin/90-configure-macos\" && chezmoi apply"
fi

info "Configuring macOS..."
each_setting apply_setting

# Show the ~/Library folder
chflags nohidden ~/Library

# FileVault status check (informational - don't auto-enable)
if ! fdesetup isactive &>/dev/null; then
    info "FileVault is not enabled. Consider enabling via System Settings > Privacy & Security"
fi

# Firewall check (informational - don't auto-enable as it can break things)
if ! /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate | grep -q "enabled"; then
    info "Firewall is not enabled. Consider enabling via System Settings"
fi

info "Verifying settings..."
each_setting verify_setting

restart_affected_apps

if ((failures > 0)); then
    error "$failures macOS setting(s) failed to apply; chezmoi will retry on the next apply"
fi

success "macOS configuration complete!"
