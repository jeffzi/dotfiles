#!/usr/bin/env bash

{{ template "bash-lib" }}

#==============================================================================
# iTerm2
#==============================================================================

info "Setting up iTerm2 preferences..."

# ~/.config/iterm2prefs is a symlink into the repo, so iTerm2 saves its
# settings straight into the chezmoi source tree.
defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$HOME/.config/iterm2prefs"
defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true

#==============================================================================
# Login items (.chezmoidata/apps.yaml)
#==============================================================================

info "Adding login items..."

failures=0
automation_denied=false

# System Events refuses these calls until this terminal is allowed to control
# it (System Settings > Privacy & Security > Automation).
if ! login_items=$(osascript -e 'tell application "System Events" to get the name of every login item'); then
    warning "Cannot manage login items: allow this terminal to control System Events in System Settings > Privacy & Security > Automation"
    automation_denied=true
fi

add_login_item() {
    local app="$1"
    local path="/Applications/$app.app"

    [[ -d "$path" ]] || return 0
    # osascript lists login items as "A, B, C"; match whole names only.
    [[ ", $login_items, " == *", $app, "* ]] && return 0

    if osascript -e "tell application \"System Events\" to make login item at end with properties {name: \"$app\", path: \"$path\", hidden: true}" >/dev/null; then
        success "Added login item: $app"
    else
        warning "Failed to add login item: $app"
        failures=$((failures + 1))
    fi
}

if [[ "$automation_denied" == false ]]; then
{{- range .loginItems }}
    add_login_item {{ . | quote }}
{{- end }}
fi

if [[ "$automation_denied" == true ]] || ((failures > 0)); then
    error "Login items are incomplete; chezmoi will retry on the next apply"
fi

success "App configuration complete!"
