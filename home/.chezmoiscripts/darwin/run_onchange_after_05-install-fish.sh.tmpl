#!/usr/bin/env bash

# Fish plugins hash: {{ include "dot_config/fish/fish_plugins" | sha256sum }}

{{ template "bash-lib" }}

#==============================================================================
# Configure fish shell
#==============================================================================

if ! command -v fish &> /dev/null; then
    warning "Fish shell not found, skipping configuration"
    exit 0
fi

info "Configuring fish shell..."
fish_path=$(command -v fish)

if ! grep -qxF "$fish_path" /etc/shells; then
    info "Adding fish to /etc/shells..."
    printf '%s\n' "$fish_path" | sudo tee -a /etc/shells >/dev/null || warning "Failed to add fish to /etc/shells (needs sudo)"
fi

# Checked on its own so a chsh that failed on an earlier run is retried.
login_shell=$(dscl . -read "/Users/$(id -un)" UserShell)
login_shell="${login_shell#UserShell: }"
if [[ "$login_shell" != "$fish_path" ]]; then
    info "Changing login shell to fish..."
    chsh -s "$fish_path" || warning "Failed to change shell to fish (run 'chsh -s $fish_path' manually)"
fi

#==============================================================================
# Install fish plugins via Fisher
#==============================================================================

info "Installing fish plugins..."
# Fisher has no install-only mode: syncing to fish_plugins also upgrades the
# plugins already installed. This runs only when fish_plugins changes.
fish -c "
    # Install fisher if not present
    if ! type -q fisher
        curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
        fisher install jorgebucaran/fisher
    end
    # Update all plugins from fish_plugins
    fisher update
" || warning "Failed to update fish plugins"

success "Fish configuration complete!"
