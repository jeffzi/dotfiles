#!/usr/bin/env bash

{{ template "bash-lib" }}

# Installs what is missing only: existing Lua builds and hererocks are never
# upgraded here. Upgrades belong to the `update` fish function.

#==============================================================================
# Install Lua & LuaJIT via hererocks
#==============================================================================

info "Installing Lua & LuaJIT..."

if ! command -v hererocks &> /dev/null; then
    info "Installing hererocks..."
    uv tool install git+https://github.com/luarocks/hererocks
fi

LUA_BASE="$HOME/.local/share/lua"

install_lua() {
    local display_name="$1"
    local dir_name="$2"
    local path="$LUA_BASE/$dir_name"
    shift 2

    if [[ ! -d "$path/bin" ]]; then
        info "Installing $display_name..."
        hererocks "$path" "$@"
    fi
}

macos_version=$(sw_vers -productVersion)
IFS=. read -r macos_major macos_minor _ <<<"$macos_version"

(
    export MACOSX_DEPLOYMENT_TARGET="${macos_major}.${macos_minor:-0}"

    install_lua "LuaJIT v2.1" "luajit" --luajit @v2.1 --luarocks latest
    install_lua "Lua 5.5" "lua5.5" --lua 5.5 --luarocks latest
    install_lua "Lua 5.4" "lua5.4" --lua 5.4 --luarocks latest
    install_lua "Lua 5.3" "lua5.3" --lua 5.3 --luarocks latest
    install_lua "Lua 5.1" "lua5.1" --lua 5.1 --luarocks latest
)

success "Lua installation complete!"
