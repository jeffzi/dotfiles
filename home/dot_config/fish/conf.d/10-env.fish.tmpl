# Environment variables
set -gx EDITOR "code --wait"

# Project paths for pj plugin
# https://github.com/oh-my-fish/plugin-pj
set -gx PROJECT_PATHS ~/Projects ~/Projects/personal
{{- if .workOrg }}
set -gxa PROJECT_PATHS ~/Projects/work/{{ .workOrg }} ~/Projects/work/{{ .workOrg }}/data-engineering/projects ~/Projects/work/{{ .workOrg }}/data-engineering/libs
{{- end }}

# Claude Code — use system ripgrep instead of the bundled Node.js wrapper
set -gx USE_BUILTIN_RIPGREP 0

# RTK — disable telemetry
set -gx RTK_TELEMETRY_DISABLED 1

# Homebrew
set -gx HOMEBREW_NO_ENV_HINTS 1

# Lua
set -gx LUA_INIT "local ok, ic = pcall(require, 'icecream'); if ok and type(ic.export) == 'function' then ic:export() end"
