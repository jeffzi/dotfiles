{
  "title": "Safe swap Button1 and Button2",
  "rules": [
    {
      "description": "Button5 → Button2 (guarded)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "pointing_button": "button5" },
          "conditions": [{ "type": "variable_if", "name": "synthetic_from_button2", "value": 0 }],
          "to": [
            { "set_variable": { "name": "synthetic_from_button5", "value": 5 } },
            { "pointing_button": "button2" },
            { "set_variable": { "name": "synthetic_from_button5", "value": 0 } }
          ]
        }
      ]
    },
    {
      "description": "Button2 → Button1 (guarded)",
      "manipulators": [
        {
          "type": "basic",
          "from": { "pointing_button": "button2" },
          "conditions": [{ "type": "variable_if", "name": "synthetic_from_button1", "value": 0 }],
          "to": [
            { "set_variable": { "name": "synthetic_from_button2", "value": 1 } },
            { "pointing_button": "button1" },
            { "set_variable": { "name": "synthetic_from_button2", "value": 0 } }
          ]
        }
      ]
    }
  ]
}
