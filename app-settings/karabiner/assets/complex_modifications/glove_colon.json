{
  "title": "Replace Shift + , with ;",
  "rules": [
    {
      "description": "Shift + , → ;",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "comma",
            "modifiers": {
              "mandatory": ["shift"],
              "optional": ["any"]
            }
          },
          "to": [{ "key_code": "semicolon" }]
        }
      ]
    }
  ]
}
